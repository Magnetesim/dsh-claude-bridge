{
  "name": "dsh-claude-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Loopback HTTP bridge that lets a local external agent create, prompt, and observe DeepSeek sessions in the running dsh web Host.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Magnetesim/dsh-claude-bridge.git"
  }
}
